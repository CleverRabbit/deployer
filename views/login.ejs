<div class="max-w-md mx-auto mt-20">
    <div class="panel shadow-xl">
        <div class="panel-heading text-center">
            <h1 class="text-xl">Login to Deployer</h1>
        </div>
        
        <div class="panel-body">
            <% if (error) { %>
                <div class="bg-red-100 border border-red-200 text-red-700 px-4 py-2 rounded text-sm mb-6">
                    <%= error %>
                </div>
            <% } %>

            <% if (typeof message !== 'undefined' && message) { %>
                <div class="bg-green-100 border border-green-200 text-green-700 px-4 py-2 rounded text-sm mb-6">
                    <%= message %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-[#777] uppercase mb-1">Email</label>
                    <input type="email" name="email" required class="form-control w-full px-3 py-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-[#777] uppercase mb-1">Password</label>
                    <input type="password" name="password" required class="form-control w-full px-3 py-2 text-sm">
                </div>
                <button type="submit" class="btn btn-primary w-full py-2.5 font-bold">Sign In</button>
            </form>
            
            <p class="mt-6 text-center text-sm text-[#999]">
                Don't have an account? <a href="/register" class="text-[#337ab7] hover:underline">Register here</a>
            </p>
        </div>
    </div>
</div>
